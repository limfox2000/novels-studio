# 部署配置模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不提交）
# scripts/deploy.sh 会读取这些变量；不使用该脚本时整个文件可以忽略。
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=ubuntu
# 推荐把本机 SSH 公钥装到服务器 authorized_keys 后免密；DEPLOY_PASS 仅作首次引导
DEPLOY_PASS=
# 可选：服务器 SSH host key 指纹（ssh-keyscan 获取）
DEPLOY_HOSTKEY=
DEPLOY_REMOTE_DIR=/home/ubuntu/novels-studio
# 站点反向代理的子路径（与 nginx location 一致）；根路径部署填 /
DEPLOY_BASE_PATH=/novels-studio
DEPLOY_URL=https://your-server.example.com/novels-studio/
